<?xml version="1.0"?>

<robot name="warehouse_robot">

  <!-- ===================================================== -->
  <!-- BASE LINK                                             -->
  <!-- ===================================================== -->

  <link name="base_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia
        ixx="0.35"
        ixy="0.0"
        ixz="0.0"
        iyy="0.35"
        iyz="0.0"
        izz="0.50"/>
    </inertial>

    <visual>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.6 0.5 0.2"/>
      </geometry>

      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>

    </visual>

    <collision>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.6 0.5 0.2"/>
      </geometry>

    </collision>

  </link>


  <!-- ===================================================== -->
  <!-- LEFT FRONT WHEEL                                      -->
  <!-- ===================================================== -->

  <link name="front_left_wheel">

    <inertial>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="1.0"/>

      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>

    </inertial>

    <visual>

      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>

        <cylinder
          radius="0.10"
          length="0.05"/>

      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>

    </visual>

    <collision>

      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>

        <cylinder
          radius="0.10"
          length="0.05"/>

      </geometry>

    </collision>

  </link>


  <joint name="front_left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>

    <child link="front_left_wheel"/>

    <origin
      xyz="0.20 0.275 -0.10"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ===================================================== -->
  <!-- LEFT REAR WHEEL                                       -->
  <!-- ===================================================== -->

  <link name="rear_left_wheel">

    <inertial>

      <origin xyz="0 0 0"/>

      <mass value="1.0"/>

      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>

    </inertial>

    <visual>

      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>

        <cylinder
          radius="0.10"
          length="0.05"/>

      </geometry>

      <material name="black"/>

    </visual>

    <collision>

      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>

        <cylinder
          radius="0.10"
          length="0.05"/>

      </geometry>

    </collision>

  </link>


  <joint name="rear_left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>

    <child link="rear_left_wheel"/>

    <origin
      xyz="-0.20 0.275 -0.10"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ===================================================== -->
  <!-- RIGHT FRONT WHEEL                                     -->
  <!-- ===================================================== -->

  <link name="front_right_wheel">

    <inertial>

      <origin xyz="0 0 0"/>

      <mass value="1.0"/>

      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>

    </inertial>

    <visual>

      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>

        <cylinder
          radius="0.10"
          length="0.05"/>

      </geometry>

      <material name="black"/>

    </visual>

    <collision>

      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>

        <cylinder
          radius="0.10"
          length="0.05"/>

      </geometry>

    </collision>

  </link>


  <joint name="front_right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>

    <child link="front_right_wheel"/>

    <origin
      xyz="0.20 -0.275 -0.10"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ===================================================== -->
  <!-- RIGHT REAR WHEEL                                      -->
  <!-- ===================================================== -->

  <link name="rear_right_wheel">

    <inertial>

      <origin xyz="0 0 0"/>

      <mass value="1.0"/>

      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>

    </inertial>

    <visual>

      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>

        <cylinder
          radius="0.10"
          length="0.05"/>

      </geometry>

      <material name="black"/>

    </visual>

    <collision>

      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>

        <cylinder
          radius="0.10"
          length="0.05"/>

      </geometry>

    </collision>

  </link>


  <joint name="rear_right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>

    <child link="rear_right_wheel"/>

    <origin
      xyz="-0.20 -0.275 -0.10"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


<!-- Gazebo ROS 2 Skid-Steer Drive -->
<gazebo>
  <plugin
    name="skid_steer_drive"
    filename="libgazebo_ros_diff_drive.so">

    <ros>
     <namespace>/</namespace>
     <argument>cmd_vel:=cmd_vel_safe</argument>
     <argument>odom:=odom</argument>
   </ros>
    <update_rate>100.0</update_rate>

    <num_wheel_pairs>2</num_wheel_pairs>

    <!-- Front wheel pair -->
    <left_joint>front_left_wheel_joint</left_joint>
    <right_joint>front_right_wheel_joint</right_joint>

    <!-- Rear wheel pair -->
    <left_joint>rear_left_wheel_joint</left_joint>
    <right_joint>rear_right_wheel_joint</right_joint>

    <!-- Front pair -->
    <wheel_separation>0.55</wheel_separation>

    <!-- Rear pair -->
    <wheel_separation>0.55</wheel_separation>

    <wheel_diameter>0.20</wheel_diameter>
    <wheel_diameter>0.20</wheel_diameter>

    <max_wheel_torque>20.0</max_wheel_torque>
    <max_wheel_acceleration>5.0</max_wheel_acceleration>

    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    <publish_wheel_tf>false</publish_wheel_tf>

    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_link</robot_base_frame>

  </plugin>
</gazebo>

<!-- LiDAR Link -->
<link name="lidar_link">
  <inertial>
    <mass value="0.2"/>
    <origin xyz="0 0 0"/>
    <inertia
      ixx="0.0001"
      ixy="0.0"
      ixz="0.0"
      iyy="0.0001"
      iyz="0.0"
      izz="0.0001"/>
  </inertial>

  <visual>
    <origin xyz="0 0 0"/>
    <geometry>
      <cylinder radius="0.08" length="0.05"/>
    </geometry>
    <material name="lidar_material">
      <color rgba="0.1 0.1 0.1 1.0"/>
    </material>
  </visual>

  <collision>
    <origin xyz="0 0 0"/>
    <geometry>
      <cylinder radius="0.08" length="0.05"/>
    </geometry>
  </collision>
</link>

<!-- LiDAR Joint -->
<joint name="lidar_joint" type="fixed">
  <parent link="base_link"/>
  <child link="lidar_link"/>
  <origin xyz="0 0 0.15" rpy="0 0 0"/>
</joint>

<!-- Gazebo LiDAR Sensor -->
<gazebo reference="lidar_link">
  <sensor name="lidar_sensor" type="ray">
    <pose>0 0 0 0 0 0</pose>

    <visualize>true</visualize>

    <update_rate>10</update_rate>

    <ray>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>

      <range>
        <min>0.12</min>
        <max>10.0</max>
        <resolution>0.01</resolution>
      </range>
    </ray>

    <plugin
      name="gazebo_ros_lidar"
      filename="libgazebo_ros_ray_sensor.so">

      <ros>
        <namespace>/</namespace>
        <argument>~/out:=/scan</argument>
      </ros>

      <output_type>sensor_msgs/LaserScan</output_type>
      <frame_name>lidar_link</frame_name>

    </plugin>
  </sensor>
</gazebo>


<!-- ===================================================== -->
<!-- IMU -->
<!-- ===================================================== -->

<link name="imu_link">

  <inertial>
    <mass value="0.05"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

    <inertia
      ixx="0.00001"
      ixy="0.0"
      ixz="0.0"
      iyy="0.00001"
      iyz="0.0"
      izz="0.00001"/>
  </inertial>

  <visual>
    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

    <geometry>
      <box size="0.05 0.05 0.02"/>
    </geometry>

    <material name="imu_material">
      <color rgba="0.8 0.2 0.2 1.0"/>
    </material>
  </visual>

  <collision>
    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

    <geometry>
      <box size="0.05 0.05 0.02"/>
    </geometry>
  </collision>

</link>


<!-- IMU fixed to robot body -->

<joint name="imu_joint" type="fixed">

  <parent link="base_link"/>

  <child link="imu_link"/>

  <origin
    xyz="0 0 0.12"
    rpy="0 0 0"/>

</joint>


<!-- Gazebo IMU sensor -->

<gazebo reference="imu_link">

  <sensor
    name="imu_sensor"
    type="imu">

    <pose>0 0 0 0 0 0</pose>

    <always_on>true</always_on>

    <update_rate>50</update_rate>

    <visualize>true</visualize>

    <plugin
      name="gazebo_ros_imu_sensor"
      filename="libgazebo_ros_imu_sensor.so">

      <ros>
        <namespace>/</namespace>
        <argument>~/out:=/imu/data</argument>
      </ros>

      <output_type>sensor_msgs/Imu</output_type>

      <frame_name>imu_link</frame_name>

    </plugin>

  </sensor>

</gazebo>


</robot>
