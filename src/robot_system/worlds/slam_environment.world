<?xml version="1.0" ?>
<sdf version="1.6">

  <world name="slam_environment">

    <!-- Ground -->
    <include>
      <uri>model://ground_plane</uri>
    </include>


    <!-- ===================================================== -->
    <!-- 10m x 8m ROOM                                         -->
    <!-- ===================================================== -->

    <!-- NORTH WALL -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 4 0.75 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10.0 0.20 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>10.0 0.20 1.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- SOUTH WALL -->
    <model name="south_wall">
      <static>true</static>
      <pose>0 -4 0.75 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10.0 0.20 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>10.0 0.20 1.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- EAST WALL -->
    <model name="east_wall">
      <static>true</static>
      <pose>5 0 0.75 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 8.0 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 8.0 1.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- WEST WALL -->
    <model name="west_wall">
      <static>true</static>
      <pose>-5 0 0.75 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 8.0 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 8.0 1.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ===================================================== -->
    <!-- OBJECT 1 - SMALL BOX                                  -->
    <!-- ===================================================== -->

    <model name="box_1">
      <static>true</static>
      <pose>-3.0 2.0 0.30 0 0 0.3</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.6 0.6 0.6</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 0.6 0.6</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ===================================================== -->
    <!-- OBJECT 2 - CYLINDER                                   -->
    <!-- ===================================================== -->

    <model name="cylinder_1">
      <static>true</static>
      <pose>2.8 2.2 0.45 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ===================================================== -->
    <!-- OBJECT 3 - RECTANGULAR BOX                            -->
    <!-- ===================================================== -->

    <model name="box_2">
      <static>true</static>
      <pose>-2.5 -2.2 0.35 0 0 -0.4</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.5 0.7</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.5 0.7</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ===================================================== -->
    <!-- OBJECT 4 - CYLINDER                                   -->
    <!-- ===================================================== -->

    <model name="cylinder_2">
      <static>true</static>
      <pose>2.5 -2.3 0.35 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.7</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.7</length>
            </cylinder>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ===================================================== -->
    <!-- OBJECT 5 - SMALL TABLE                                -->
    <!-- ===================================================== -->

    <model name="table_obstacle">
      <static>true</static>
      <pose>0 2.0 0.4 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 0.5 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 0.5 0.8</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ===================================================== -->
    <!-- OBJECT 6 - SMALL BOX                                  -->
    <!-- ===================================================== -->

    <model name="box_3">
      <static>true</static>
      <pose>0 -2.0 0.30 0 0 0.5</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.6 0.6 0.6</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 0.6 0.6</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ===================================================== -->
    <!-- OBJECT 7 - CYLINDER                                   -->
    <!-- ===================================================== -->

    <model name="cylinder_3">
      <static>true</static>
      <pose>-1.0 0.0 0.45 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ===================================================== -->
    <!-- OBJECT 8 - SHELF / WALL-LIKE LANDMARK                 -->
    <!-- ===================================================== -->

    <model name="small_shelf">
      <static>true</static>
      <pose>1.5 0.0 0.5 0 0 1.57</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 0.4 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 0.4 1.0</size>
            </box>
          </geometry>
         </visual>

      </link>
    </model>


  </world>

</sdf>
